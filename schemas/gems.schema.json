{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gem types: base reward per matched gem and default spawn weight",
  "type": "object",
  "required": ["skull_bomb_damage", "gems"],
  "additionalProperties": false,
  "properties": {
    "skull_bomb_damage": {
      "description": "Bonus damage a matched or blasted SKULL_BOMB deals, on top of the skulls it clears.",
      "type": "integer",
      "minimum": 0
    },
    "gems": {
      "description": "One entry per spawnable gem type; content_lint checks ids are unique, so 7 entries means every type exactly once.",
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "spawn_weight", "reward", "amount"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["red", "blue", "green", "yellow", "skull", "action", "gold"] },
          "spawn_weight": { "type": "integer", "minimum": 0 },
          "reward": { "enum": ["mana", "damage", "ap", "gold"] },
          "amount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
